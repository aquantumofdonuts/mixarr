# Mixarr Environment Configuration
# Copy this to .env and customize values
# Generate secrets with: openssl rand -hex 32

# Required for production
SESSION_SECRET=

# Database (docker-compose.yml stack)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_DATABASE=mixarr
MYSQL_USER=mixarr

# URLs (adjust for your domain/IP)
BASE_URL=https://localhost:3443
FRONTEND_URL=https://localhost:3443