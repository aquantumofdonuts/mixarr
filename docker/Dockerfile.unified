# syntax=docker/dockerfile:1.4
# Unified Dockerfile for Mixarr - FULLY SELF-CONTAINED
# Includes: API, Web, Caddy, MySQL, and Redis
# Designed for single-container deployment on Unraid and similar platforms

# =============================================================================
# BASE STAGE
# =============================================================================
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl openssl-dev

# =============================================================================
# DEPENDENCIES STAGE
# =============================================================================
FROM base AS deps
COPY package*.json ./
COPY turbo.json ./
COPY tsconfig.base.json ./
COPY apps/api/package*.json ./apps/api/
COPY apps/web/package*.json ./apps/web/
COPY packages/shared-types/package*.json ./packages/shared-types/
COPY packages/config/package*.json ./packages/config/
RUN --mount=type=cache,target=/root/.npm \
    npm install

# =============================================================================
# BUILD STAGE - API
# =============================================================================
FROM deps AS builder-api
COPY . .
WORKDIR /app/apps/api
RUN npx prisma generate
WORKDIR /app
RUN npm run build --workspace=@mixarr/api

# =============================================================================
# BUILD STAGE - WEB
# =============================================================================
FROM deps AS builder-web
COPY . .
# API_URL points to internal API on same container
ARG API_URL=http://localhost:3005
ENV API_URL=${API_URL}
# CI=true disables build-time font optimization to prevent timeouts during slow ARM64 builds
ENV CI=true
# Build shared-types first (web depends on it)
RUN npm run build --workspace=@mixarr/shared-types
RUN npm run build --workspace=@mixarr/web

# =============================================================================
# PRODUCTION STAGE
# =============================================================================
FROM node:20-alpine AS production
WORKDIR /app

# Install runtime dependencies including MySQL and Redis
RUN apk add --no-cache \
    openssl \
    caddy \
    supervisor \
    curl \
    mariadb \
    mariadb-client \
    redis

# Create non-root user for app processes
RUN addgroup -S mixarr && adduser -S -G mixarr -h /app mixarr

# Create directories
RUN mkdir -p /app/api /app/web /data/certs /data/mysql /data/redis /var/log/supervisor /run/mysqld \
    && chown -R mysql:mysql /data/mysql /run/mysqld

# -----------------------------------------------------------------------------
# Copy API build
# -----------------------------------------------------------------------------
COPY --from=builder-api /app/apps/api/dist /app/api/dist
COPY --from=builder-api /app/apps/api/package*.json /app/api/
COPY --from=builder-api /app/apps/api/prisma /app/api/prisma

# Copy node_modules - npm workspaces hoists all deps to root
COPY --from=builder-api /app/node_modules /app/api/node_modules

# Generate Prisma client in production
WORKDIR /app/api
RUN npx prisma generate

# -----------------------------------------------------------------------------
# Copy Web build
# -----------------------------------------------------------------------------
WORKDIR /app
COPY --from=builder-web /app/apps/web/.next/standalone /app/web/
COPY --from=builder-web /app/apps/web/.next/static /app/web/apps/web/.next/static
COPY --from=builder-web /app/apps/web/public /app/web/apps/web/public

# Fix ownership for non-root user
RUN chown -R mixarr:mixarr /app

# -----------------------------------------------------------------------------
# MariaDB configuration
# -----------------------------------------------------------------------------
COPY <<'EOF' /etc/my.cnf.d/mixarr.cnf
[mysqld]
datadir=/data/mysql
socket=/run/mysqld/mysqld.sock
user=mysql
bind-address=127.0.0.1
port=3306
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
skip-networking=0

[client]
socket=/run/mysqld/mysqld.sock
EOF

# -----------------------------------------------------------------------------
# Redis configuration
# -----------------------------------------------------------------------------
COPY <<'EOF' /etc/redis-mixarr.conf
bind 127.0.0.1
port 6379
dir /data/redis
appendonly yes
appendfilename "appendonly.aof"
EOF

# -----------------------------------------------------------------------------
# Caddy configuration
# -----------------------------------------------------------------------------
COPY <<'EOF' /etc/caddy/Caddyfile
# Mixarr Caddyfile - Unified container
:443 {
    tls /data/certs/cert.pem /data/certs/key.pem
    
    # API routes
    handle /api/* {
        reverse_proxy localhost:3005
    }
    
    # OAuth callback routes (must go to API)
    handle /auth/* {
        reverse_proxy localhost:3005
    }
    
    # Everything else goes to Next.js
    handle {
        reverse_proxy localhost:3000
    }
    
    encode gzip
    log {
        output stdout
        format console
    }
}

:80 {
    redir https://{host}{uri} permanent
}
EOF

# -----------------------------------------------------------------------------
# Supervisor configuration
# -----------------------------------------------------------------------------
COPY <<'EOF' /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid
user=root

[program:mariadb]
command=/usr/bin/mysqld_safe --datadir=/data/mysql
autostart=true
autorestart=true
priority=10
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:redis]
command=/usr/bin/redis-server /etc/redis-mixarr.conf
autostart=true
autorestart=true
priority=10
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:api]
command=node /app/api/dist/index.js
user=mixarr
directory=/app/api
autostart=true
autorestart=true
startsecs=10
startretries=5
priority=20
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
environment=NODE_ENV=production,PORT=3005,DATABASE_URL="%(ENV_DATABASE_URL)s",REDIS_URL="redis://127.0.0.1:6379",SESSION_SECRET="%(ENV_SESSION_SECRET)s"

[program:web]
command=node /app/web/apps/web/server.js
user=mixarr
directory=/app/web
autostart=true
autorestart=true
startsecs=5
priority=30
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
environment=NODE_ENV=production,PORT=3000,HOSTNAME=0.0.0.0,API_URL=http://localhost:3005

[program:caddy]
command=caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
autostart=true
autorestart=true
priority=30
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
EOF

# -----------------------------------------------------------------------------
# Entrypoint script
# -----------------------------------------------------------------------------
COPY <<'ENTRYPOINT' /entrypoint.sh
#!/bin/sh
set -e

echo "=== Mixarr Unified Container Starting ==="

# -----------------------------------------------------------------------------
# Auto-generate SESSION_SECRET if not provided
# -----------------------------------------------------------------------------
if [ -z "$SESSION_SECRET" ]; then
  export SESSION_SECRET=$(openssl rand -hex 32)
  echo "Generated random SESSION_SECRET (will change on restart)"
  echo "Set SESSION_SECRET explicitly for persistent sessions."
fi

# -----------------------------------------------------------------------------
# Setup directories and permissions
# -----------------------------------------------------------------------------
mkdir -p /data/certs /data/mysql /data/redis /run/mysqld
chown -R mysql:mysql /data/mysql /run/mysqld
chown -R redis:redis /data/redis 2>/dev/null || true

# -----------------------------------------------------------------------------
# Auto-generate database credentials if not provided
# Credentials are persisted to /data/.mixarr_credentials so they survive
# container restarts without the user needing to set MYSQL_PASSWORD explicitly.
# -----------------------------------------------------------------------------
CREDS_FILE="/data/.mixarr_credentials"
CREDS_FILE_IS_NEW=0

if [ -z "$MYSQL_PASSWORD" ]; then
  if [ -f "$CREDS_FILE" ]; then
    chmod 600 "$CREDS_FILE"
    export MYSQL_PASSWORD=$(grep '^MYSQL_PASSWORD=' "$CREDS_FILE" | cut -d= -f2-)
    if [ -z "$MYSQL_PASSWORD" ]; then
      echo "WARNING: $CREDS_FILE is malformed or missing key; regenerating credentials"
      export MYSQL_PASSWORD=$(openssl rand -hex 16)
      printf 'MYSQL_PASSWORD=%s\n' "$MYSQL_PASSWORD" > "$CREDS_FILE"
      chmod 600 "$CREDS_FILE"
      CREDS_FILE_IS_NEW=1
    else
      echo "Restored MYSQL_PASSWORD from $CREDS_FILE"
    fi
  else
    export MYSQL_PASSWORD=$(openssl rand -hex 16)
    printf 'MYSQL_PASSWORD=%s\n' "$MYSQL_PASSWORD" > "$CREDS_FILE"
    chmod 600 "$CREDS_FILE"
    CREDS_FILE_IS_NEW=1
    echo "Generated random MYSQL_PASSWORD (persisted to $CREDS_FILE)"
    echo "Set MYSQL_PASSWORD env var explicitly only to override or rotate the persisted password."
  fi
fi

if [ -z "$MYSQL_ROOT_PASSWORD" ]; then
  export MYSQL_ROOT_PASSWORD=$(openssl rand -hex 16)
  echo "Generated random MYSQL_ROOT_PASSWORD"
fi

# Update DATABASE_URL with the actual password
export DATABASE_URL="mysql://mixarr:${MYSQL_PASSWORD}@127.0.0.1:3306/mixarr"

# -----------------------------------------------------------------------------
# Initialize MariaDB if needed
# -----------------------------------------------------------------------------
if [ ! -d "/data/mysql/mysql" ]; then
    echo "Initializing MariaDB database..."
    mysql_install_db --user=mysql --datadir=/data/mysql --auth-root-authentication-method=normal
    
    # Start MariaDB temporarily for setup
    /usr/bin/mysqld_safe --datadir=/data/mysql &
    MYSQL_PID=$!
    
    # Wait for MariaDB to be ready
    echo "Waiting for MariaDB to start..."
    for i in $(seq 1 30); do
        if mysqladmin ping -h 127.0.0.1 --silent 2>/dev/null; then
            break
        fi
        sleep 1
    done
    
    # Create database and user
    echo "Creating Mixarr database and user..."
    mysql -u root <<-EOSQL
        CREATE DATABASE IF NOT EXISTS mixarr CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
        CREATE USER IF NOT EXISTS 'mixarr'@'127.0.0.1' IDENTIFIED BY '${MYSQL_PASSWORD}';
        CREATE USER IF NOT EXISTS 'mixarr'@'localhost' IDENTIFIED BY '${MYSQL_PASSWORD}';
        GRANT ALL PRIVILEGES ON mixarr.* TO 'mixarr'@'127.0.0.1';
        GRANT ALL PRIVILEGES ON mixarr.* TO 'mixarr'@'localhost';
        FLUSH PRIVILEGES;
EOSQL
    
    # Stop temporary MariaDB
    mysqladmin -u root shutdown
    sleep 2
    echo "MariaDB initialized successfully"
else
    # DB already exists. If the creds file was just created this run, the
    # stored password may differ from what MariaDB has (e.g. existing users
    # who never set MYSQL_PASSWORD explicitly and are upgrading from a version
    # that did not persist credentials). Reset the MariaDB user password to
    # match so the connection succeeds without data loss.
    if [ "$CREDS_FILE_IS_NEW" = "1" ]; then
        echo "Migrating database credentials to persisted creds file..."
        # Start MariaDB temporarily to rotate the password
        /usr/bin/mysqld_safe --datadir=/data/mysql &
        MIGRATE_PID=$!
        DB_READY=0
        for i in $(seq 1 30); do
            if mysqladmin ping -h 127.0.0.1 --silent 2>/dev/null; then
                DB_READY=1
                break
            fi
            sleep 1
        done
        if [ "$DB_READY" != "1" ]; then
            echo "ERROR: MariaDB did not become reachable for credential migration" >&2
            exit 1
        fi
        if ! mysql -u root -e \
            "ALTER USER 'mixarr'@'127.0.0.1' IDENTIFIED BY '${MYSQL_PASSWORD}'; \
             ALTER USER 'mixarr'@'localhost' IDENTIFIED BY '${MYSQL_PASSWORD}'; \
             FLUSH PRIVILEGES;"; then
            echo "ERROR: Credential migration failed; database credentials were not rotated" >&2
            mysqladmin -u root shutdown >/dev/null 2>&1 || true
            sleep 2
            exit 1
        fi
        mysqladmin -u root shutdown
        sleep 2
        echo "Credential migration complete"
    fi
fi

# -----------------------------------------------------------------------------
# Generate SSL certificate if needed
# -----------------------------------------------------------------------------
CERT_DIR="/data/certs"
CERT_FILE="$CERT_DIR/cert.pem"
KEY_FILE="$CERT_DIR/key.pem"

if [ ! -f "$CERT_FILE" ] || [ ! -f "$KEY_FILE" ]; then
    echo "Generating self-signed certificate..."
    
    # Extract host from BASE_URL or use default
    HOST=$(echo "${BASE_URL:-https://localhost}" | sed -E 's|^https?://||' | sed -E 's|:[0-9]+.*||' | sed -E 's|/.*||')
    
    # Check if host is an IP
    if echo "$HOST" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
        SAN="IP:127.0.0.1,IP:$HOST,DNS:localhost"
    else
        SAN="IP:127.0.0.1,DNS:localhost,DNS:$HOST"
    fi
    
    openssl req -x509 -newkey rsa:2048 \
        -keyout "$KEY_FILE" \
        -out "$CERT_FILE" \
        -days 365 \
        -nodes \
        -subj "/CN=$HOST" \
        -addext "subjectAltName=$SAN"
    
    echo "Certificate generated for: $HOST"
fi

# -----------------------------------------------------------------------------
# Optionally disable Caddy (for external reverse proxy setups)
# -----------------------------------------------------------------------------
if [ -n "${DISABLE_CADDY}" ]; then
    echo "DISABLE_CADDY is set - disabling built-in Caddy reverse proxy"
    echo "Configure your external reverse proxy to forward to http://localhost:3000"
    sed -i '/\[program:caddy\]/,/stderr_logfile_maxbytes=0/{s/autostart=true/autostart=false/;s/autorestart=true/autorestart=false/}' /etc/supervisor/conf.d/supervisord.conf
fi

# -----------------------------------------------------------------------------
# Run database migrations before starting services (prevents API startup race)
# -----------------------------------------------------------------------------
echo "Running database migrations..."
/usr/bin/mysqld_safe --datadir=/data/mysql &
for i in $(seq 1 30); do
    if mysqladmin ping -h 127.0.0.1 --silent 2>/dev/null; then
        break
    fi
    sleep 1
done
cd /app/api
export REDIS_URL="redis://127.0.0.1:6379"
npx prisma db push --accept-data-loss || echo "Warning: Database migration had issues, continuing..."
mysqladmin -u root shutdown 2>/dev/null || true
sleep 2

# -----------------------------------------------------------------------------
# Start all services via supervisor
# -----------------------------------------------------------------------------
echo "Starting all services..."
/usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf &
SUPERVISOR_PID=$!

echo "=== Mixarr is starting up ==="
if [ -n "${DISABLE_CADDY}" ]; then
    echo "Access the web interface at http://[your-ip]:3010"
else
    echo "Access the web interface at https://[your-ip]:443"
fi

# Keep container running
wait $SUPERVISOR_PID
ENTRYPOINT

RUN chmod +x /entrypoint.sh

# Environment variables with defaults (internal DB/Redis used by default)
ENV NODE_ENV=production
ENV PORT=3005
ENV DATABASE_URL=""
ENV REDIS_URL="redis://127.0.0.1:6379"
ENV SESSION_SECRET=""
ENV MYSQL_PASSWORD=""
ENV MYSQL_ROOT_PASSWORD=""
ENV FRONTEND_URL=""
ENV BASE_URL=""
ENV DISABLE_CADDY=""

# Expose ports
EXPOSE 80 443 3010

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:3005/api/health || exit 1

# Data volume - includes MySQL data, Redis data, and certificates
VOLUME ["/data"]

ENTRYPOINT ["/entrypoint.sh"]
